import type { SeatDto } from '../../Interfaces/Reservation.type';
import { getSeatStyles, canSelectSeat, SectionOrder } from '../../constants/SeatColors';
import styles from './SeatsMap.module.css';

interface SeatsMapProps {
  
  seats: SeatDto[];
  
  selectedSeatIds: number[];
  
  onSeatClick: (seat: SeatDto, isSelected: boolean) => void;
}


function groupSeatsBySection(seats: SeatDto[]): Record<string, SeatDto[]> {
  return seats.reduce((grouped, seat) => {
    if (!grouped[seat.section]) {
      grouped[seat.section] = [];
    }
    grouped[seat.section].push(seat);
    return grouped;
  }, {} as Record<string, SeatDto[]>);
}


function sortSeatsByNumber(seats: SeatDto[]): SeatDto[] {
  return [...seats].sort((a, b) => {
    const aMatch = a.seatNumber.match(/([A-Z]+)(\d+)/);
    const bMatch = b.seatNumber.match(/([A-Z]+)(\d+)/);
    
    if (!aMatch || !bMatch) return 0;
    
    const aLetter = aMatch[1];
    const aNumber = parseInt(aMatch[2], 10);
    const bLetter = bMatch[1];
    const bNumber = parseInt(bMatch[2], 10);
    
    if (aLetter !== bLetter) return aLetter.localeCompare(bLetter);
    return aNumber - bNumber;
  });
}


export function SeatsMap({ seats, selectedSeatIds, onSeatClick }: SeatsMapProps) {
  const groupedSeats = groupSeatsBySection(seats);
  
  const orderedSections = SectionOrder.filter(section => groupedSeats[section]);

  return (
    <div className={styles.seatsMapContainer}>
      <h2 className={styles.title}>Selecciona tus Asientos</h2>
      
      {orderedSections.length === 0 ? (
        <div className={styles.emptyMessage}>
          <p>No hay asientos disponibles para esta función</p>
        </div>
      ) : (
        orderedSections.map((sectionName) => (
          <Section
            key={sectionName}
            sectionName={sectionName}
            seats={sortSeatsByNumber(groupedSeats[sectionName])}
            selectedSeatIds={selectedSeatIds}
            onSeatClick={onSeatClick}
          />
        ))
      )}
    </div>
  );
}


interface SectionProps {
  sectionName: string;
  seats: SeatDto[];
  selectedSeatIds: number[];
  onSeatClick: (seat: SeatDto, isSelected: boolean) => void;
}

function Section({ sectionName, seats, selectedSeatIds, onSeatClick }: SectionProps) {
  return (
    <div className={styles.section}>
      <div className={styles.sectionHeader}>
        <h3 className={styles.sectionTitle}>{sectionName}</h3>
        <span className={styles.sectionPrice}>
          ${seats[0]?.price.toLocaleString()} por asiento
        </span>
      </div>
      
      <div className={styles.seatsGrid}>
        {seats.map((seat) => (
          <Seat
            key={seat.id}
            seat={seat}
            isSelected={selectedSeatIds.includes(seat.id)}
            onSeatClick={onSeatClick}
          />
        ))}
      </div>
    </div>
  );
}


interface SeatProps {
  seat: SeatDto;
  isSelected: boolean;
  onSeatClick: (seat: SeatDto, isSelected: boolean) => void;
}

function Seat({ seat, isSelected, onSeatClick }: SeatProps) {
  const canClick = canSelectSeat(seat.status);
  
  
  const seatStyles = getSeatStyles(seat.status, isSelected);

  const handleClick = () => {
    if (!canClick) {
      alert(`Este asiento no está disponible`);
      return;
    }
    
    onSeatClick(seat, isSelected);
  };

  return (
    <button
      className={styles.seat}
      onClick={handleClick}
      disabled={!canClick && !isSelected}
      style={seatStyles as React.CSSProperties}
      title={`${seat.seatNumber} - ${seat.section}`}
      aria-label={`Asiento ${seat.seatNumber}, ${seat.section}, $${seat.price}`}
    >
      <span className={styles.seatNumber}>{seat.seatNumber}</span>
      
      {/* Mostrar icono si está seleccionado */}
      {isSelected && <span className={styles.selectedIcon}>✓</span>}
    </button>
  );
}

export default SeatsMap;
</file>

