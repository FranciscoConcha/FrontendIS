<file path="src/components/FormReactive.css">
.form-reactive-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  background: linear-gradient(135deg, #ffffff 0%, #c1c1c1 100%);
}

.form-reactive-box {
  background: white;
  padding: 40px;
  border-radius: 12px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  width: 100%;
  max-width: 450px;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.form-reactive-title {
  font-size: 28px;
  color: #2c3e50;
  text-align: center;
  margin: 0 0 8px 0;
  font-weight: 700;
}

.form-reactive-subtitle {
  font-size: 16px;
  color: #949494;
  text-align: center;
  margin: 0 0 24px 0;
  font-weight: 500;
}

/* Alertas */
.form-reactive-alert {
  padding: 14px 16px;
  border-radius: 8px;
  margin-bottom: 20px;
  font-size: 14px;
  border-left: 4px solid;
}

.form-reactive-alert.error {
  background-color: #fee;
  color: #c33;
  border-left-color: #c33;
}

.form-reactive-alert.info {
  background-color: #e3f2fd;
  color: #1976d2;
  border-left-color: #1976d2;
}

/* Formulario */
.form-reactive {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Grupo de campo */
.form-reactive-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-reactive-label {
  font-size: 14px;
  font-weight: 600;
  color: #2c3e50;
  display: flex;
  align-items: center;
  gap: 4px;
}

.required {
  color: #e74c3c;
  font-weight: 700;
}

/* Inputs */
.form-reactive-input {
  padding: 12px 14px;
  border: 2px solid #ecf0f1;
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
  transition: all 0.3s;
  background: white;
  color: #2c3e50;
}

.form-reactive-input:focus {
  outline: none;
  border-color: #667eea;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.form-reactive-input:disabled {
  background-color: #ecf0f1;
  cursor: not-allowed;
  opacity: 0.6;
}

.form-reactive-input.error {
  border-color: #e74c3c;
  background-color: #fadbd8;
}

.form-reactive-input.error:focus {
  box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.1);
}

.form-reactive-input::placeholder {
  color: #95a5a6;
}

.textarea {
  resize: vertical;
  min-height: 100px;
}

/* Mensajes de error */
.form-reactive-error {
  font-size: 12px;
  color: #e74c3c;
  font-weight: 500;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* Botón envío */
.form-reactive-submit {
  padding: 14px 20px;
  background: linear-gradient(135deg, #b4b4b4 0%, #c9c9c9 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
  margin-top: 10px;
}

.form-reactive-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
}

.form-reactive-submit:active:not(:disabled) {
  transform: translateY(0);
}

.form-reactive-submit:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

/* Responsive */
@media (max-width: 600px) {
  .form-reactive-box {
    padding: 30px 20px;
  }

  .form-reactive-title {
    font-size: 24px;
  }

  .form-reactive-subtitle {
    font-size: 14px;
  }

  .form-reactive-input {
    padding: 12px;
    font-size: 16px; /* Prevenir zoom en iOS */
  }

  .form-reactive-submit {
    padding: 12px 16px;
    font-size: 14px;
  }
}

@media (max-width: 380px) {
  .form-reactive-box {
    padding: 24px 16px;
    border-radius: 8px;
  }

  .form-reactive-title {
    font-size: 20px;
  }

  .form-reactive-subtitle {
    font-size: 13px;
    margin-bottom: 20px;
  }
}
